# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY and TOKEN_ENCRYPTION_KEYS with:
#   docker compose run --rm api python -m clipfarm.cli gen-keys

SECRET_KEY=
# Comma-separated Fernet keys; the first encrypts. To rotate, put a new key first and keep the old one.
TOKEN_ENCRYPTION_KEYS=
TIMEZONE=UTC
# Set to true once you serve the app over HTTPS.
SESSION_COOKIE_SECURE=false

POSTGRES_PASSWORD=change-me

STORAGE_BACKEND=s3
S3_ACCESS_KEY=clipfarm-minio
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=clipfarm
S3_REGION=us-east-1
# For AWS S3 / Cloudflare R2, set S3_ENDPOINT_URL here and remove the override in docker-compose.yml.

# --- Later steps (leave empty for now) ---
# Step 3: moment scoring
ANTHROPIC_API_KEY=
# Turn off to keep frames of children from being sent to the LLM; the reviewer checklist still applies.
SAFETY_VISION_ENABLED=true
# Step 2/6: YouTube (Google Cloud OAuth client, type "Web application")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Step 2: Drive / Dropbox intake
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Step 6: Instagram (Meta app)
META_APP_ID=
META_APP_SECRET=
# Step 6: TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set true only after TikTok approves your Content Posting API audit.
TIKTOK_DIRECT_POST_AUDITED=false
